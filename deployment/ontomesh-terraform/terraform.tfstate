            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kafka-cluster:DescribeCluster\",\n        \"kafka-cluster:Connect\"\n      ],\n      \"Resource\": \"arn:aws:kafka:ap-south-2:077405089348:cluster/ontomesh-msk/f619fe40-bdc0-4972-a32b-99c9677ef34a-2\"\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kafka-cluster:WriteData\",\n        \"kafka-cluster:ReadData\",\n        \"kafka-cluster:DescribeTopic\",\n        \"kafka-cluster:CreateTopic\"\n      ],\n      \"Resource\": \"arn:aws:kafka:ap-south-2:077405089348:topic/ontomesh-msk/*\"\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kafka-cluster:DescribeGroup\",\n        \"kafka-cluster:AlterGroup\"\n      ],\n      \"Resource\": \"arn:aws:kafka:ap-south-2:077405089348:group/ontomesh-msk/*\"\n    }\n  ]\n}",
