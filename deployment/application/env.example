# ========================================
# OntoMesh Docker Compose Environment Variables
# ========================================

# Config Server Configuration
CONFIG_SERVER_PORT=8080
CONFIG_USERNAME=configuser
CONFIG_PASSWORD=configpass
SEARCH_LOCATIONS=file:/app/config-repo
DISCOVERY_CLIENT_ENABLED=true

# Service Discovery Configuration
CONFIG_SERVER_URL=http://config-server:8080
SERVICE_DISCOVERY_PROFILE=dev
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=server
SERVICE_DISCOVERY_HOST=service-discovery
SERVICE_DISCOVERY_SERVER_PORT=8080
SERVICE_DISCOVERY_URL=http://eureka:server@service-discovery:8080/eureka

# ONE Record Client Configuration
ONERECORD_CLIENT_PROFILES=dev
ONERECORD_CLIENT_PORT=8080
KAFKA_TOPIC_CLIENT=logistics-client

# ONE Record Processor Configuration
ONERECORD_PROCESSOR_PORT=8080
ONERECORD_PROCESSOR_PROFILES=dev
KAFKA_TOPIC_PROCESSOR=logistics-processor
LOGISTICS_EVENTS_NOTIFICATION_TOPIC=logistics-events-notification

# ONE Record Server Configuration
ONERECORD_SERVER_PORT=8080
ONERECORD_SERVER_PROFILES=dev
ONERECORD_SERVER_URL=http://localhost:8085
IRI_SCHEME=https
KAFKA_TOPIC_SERVER=logistics-server
LOGISTICS_EVENTS_TOPIC=logistics-events
LOGISTICS_SERVER_ID=957e2622-9d31-493b-8b8f-3c805064dbda

# GraphDB Configuration
REPOSITORY_URL=http://graphdb:7200
REPOSITORY_NAME=ontomesh
REPOSITORY_USERNAME=admin
REPOSITORY_PASSWORD=admin

# Kafka Configuration (Single Node)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=ontomesh-client
KAFKA_GROUP_ID=ontomesh-group

# Keycloak Configuration
ISSUER_URI=https://keycloak.ontomesh.io:8443/realms/ontomesh
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak

# ========================================
# Port Configuration Summary
# ========================================
# 
# External Ports (Host -> Container):
# - Config Server:     8888 -> 8080
# - Service Discovery: 8761 -> 8080
# - 1r-client:         8081 -> 8080
# - 1r-processor:      8083 -> 8080
# - 1r-server:         8085 -> 8080
# - Kafka:             9092 -> 9092
# - Keycloak:          8443 -> 8443
# - GraphDB REST:      7200 -> 7200
# - GraphDB Workbench: 7300 -> 7300
#
# Internal Container Ports:
# - All Spring Boot apps: 8080
# - Kafka: 9092
# - Keycloak: 8443
# - GraphDB: 7200, 7300
# - PostgreSQL: 5432 (internal only) 