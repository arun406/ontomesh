#!/bin/bash

# OntoMesh Environment Setup Script
# This script helps create and configure the .env file with all required environment variables

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${GREEN}✅${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠️${NC} $1"
}

print_info() {
    echo -e "${BLUE}ℹ️${NC} $1"
}

print_error() {
    echo -e "${RED}❌${NC} $1"
}

# Function to show usage
show_usage() {
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -h, --help              Show this help message"
    echo "  -n, --non-interactive   Use default values without prompts"
    echo "  -s, --section SECTION   Configure only specific section"
    echo "  -f, --force             Overwrite existing .env file"
    echo "  --show-sections         List available configuration sections"
    echo ""
    echo "Available sections:"
    echo "  config-server, service-discovery, client, processor, server,"
    echo "  graphdb, kafka, keycloak, all"
    echo ""
    echo "Examples:"
    echo "  $0                      # Interactive setup"
    echo "  $0 -n                   # Non-interactive with defaults"
    echo "  $0 -s service-discovery # Configure only service discovery"
    echo "  $0 -s all -n            # Configure all sections with defaults"
}

# Function to get user input with default value
get_input() {
    local prompt="$1"
    local default="$2"
    local current="$3"
    local non_interactive="$4"
    
    if [ "$non_interactive" = "true" ]; then
        echo "${default}"
        return
    fi
    
    if [ -n "$current" ]; then
        echo -e "${BLUE}Current value:${NC} $current"
    fi
    
    if [ -n "$default" ]; then
        read -p "$prompt [$default]: " input
        echo "${input:-$default}"
    else
        read -p "$prompt: " input
        echo "$input"
    fi
}

# Function to update or add environment variable
update_env_var() {
    local var_name="$1"
    local new_value="$2"
    local file="$3"
    
    if grep -q "^${var_name}=" "$file"; then
        # Variable exists, update it
        sed -i.bak "s/^${var_name}=.*/${var_name}=${new_value}/" "$file"
        rm -f "${file}.bak"
    else
        # Variable doesn't exist, add it
        echo "${var_name}=${new_value}" >> "$file"
    fi
}

# Function to get default value for a variable
get_default_value() {
    local var_name="$1"
    case "$var_name" in
        CONFIG_SERVER_PORT) echo "8080" ;;
        CONFIG_USERNAME) echo "configuser" ;;
        CONFIG_PASSWORD) echo "configpass" ;;
        SEARCH_LOCATIONS) echo "file:/app/config-repo" ;;
        DISCOVERY_CLIENT_ENABLED) echo "true" ;;
        CONFIG_SERVER_URL) echo "http://config-server:8080" ;;
        SERVICE_DISCOVERY_PROFILE) echo "dev" ;;
        EUREKA_USERNAME) echo "eureka" ;;
        EUREKA_PASSWORD) echo "server" ;;
        SERVICE_DISCOVERY_HOST) echo "service-discovery" ;;
        SERVICE_DISCOVERY_SERVER_PORT) echo "8080" ;;
        ONERECORD_CLIENT_PROFILES) echo "dev" ;;
        ONERECORD_CLIENT_PORT) echo "8080" ;;
        ONERECORD_PROCESSOR_PORT) echo "8080" ;;
        ONERECORD_PROCESSOR_PROFILES) echo "dev" ;;
        ONERECORD_SERVER_PORT) echo "8080" ;;
        ONERECORD_SERVER_PROFILES) echo "dev" ;;
        ONERECORD_SERVER_URL) echo "http://localhost:8085" ;;
        IRI_SCHEME) echo "https" ;;
        REPOSITORY_URL) echo "http://graphdb:7200" ;;
        REPOSITORY_NAME) echo "ontomesh" ;;
        REPOSITORY_USERNAME) echo "admin" ;;
        REPOSITORY_PASSWORD) echo "admin" ;;
        KAFKA_BOOTSTRAP_SERVERS) echo "kafka:9092" ;;
        KAFKA_CLIENT_ID) echo "ontomesh-client" ;;
        KAFKA_GROUP_ID) echo "ontomesh-group" ;;
        ISSUER_URI) echo "https://keycloak.ontomesh.io:8443/realms/ontomesh" ;;
        POSTGRES_USER) echo "keycloak" ;;
        POSTGRES_PASSWORD) echo "keycloak" ;;
        KC_DB_USERNAME) echo "keycloak" ;;
        KC_DB_PASSWORD) echo "keycloak" ;;
        *) echo "" ;;
    esac
}

# Function to get section display name
get_section_name() {
    local section="$1"
    case "$section" in
        config-server) echo "Config Server" ;;
        service-discovery) echo "Service Discovery" ;;
        client) echo "ONE Record Client" ;;
        processor) echo "ONE Record Processor" ;;
        server) echo "ONE Record Server" ;;
        graphdb) echo "GraphDB" ;;
        kafka) echo "Kafka" ;;
        keycloak) echo "Keycloak" ;;
        *) echo "$section" ;;
    esac
}

# Function to get variables for a section
get_section_vars() {
    local section="$1"
    case "$section" in
        config-server) echo "CONFIG_SERVER_PORT CONFIG_USERNAME CONFIG_PASSWORD SEARCH_LOCATIONS DISCOVERY_CLIENT_ENABLED" ;;
        service-discovery) echo "CONFIG_SERVER_URL SERVICE_DISCOVERY_PROFILE EUREKA_USERNAME EUREKA_PASSWORD SERVICE_DISCOVERY_HOST SERVICE_DISCOVERY_SERVER_PORT" ;;
        client) echo "ONERECORD_CLIENT_PROFILES ONERECORD_CLIENT_PORT" ;;
        processor) echo "ONERECORD_PROCESSOR_PORT ONERECORD_PROCESSOR_PROFILES" ;;
        server) echo "ONERECORD_SERVER_PORT ONERECORD_SERVER_PROFILES ONERECORD_SERVER_URL IRI_SCHEME" ;;
        graphdb) echo "REPOSITORY_URL REPOSITORY_NAME REPOSITORY_USERNAME REPOSITORY_PASSWORD" ;;
        kafka) echo "KAFKA_BOOTSTRAP_SERVERS KAFKA_CLIENT_ID KAFKA_GROUP_ID" ;;
        keycloak) echo "ISSUER_URI POSTGRES_USER POSTGRES_PASSWORD KC_DB_USERNAME KC_DB_PASSWORD" ;;
        *) echo "" ;;
    esac
}

# Function to check if section exists
section_exists() {
    local section="$1"
    case "$section" in
        config-server|service-discovery|client|processor|server|graphdb|kafka|keycloak|all) return 0 ;;
        *) return 1 ;;
    esac
}

# Parse command line arguments
NON_INTERACTIVE=false
FORCE=false
SELECTED_SECTION=""
SHOW_SECTIONS=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_usage
            exit 0
            ;;
        -n|--non-interactive)
            NON_INTERACTIVE=true
            shift
            ;;
        -f|--force)
            FORCE=true
            shift
            ;;
        -s|--section)
            SELECTED_SECTION="$2"
            shift 2
            ;;
        --show-sections)
            SHOW_SECTIONS=true
            shift
            ;;
        *)
            print_error "Unknown option: $1"
            show_usage
            exit 1
            ;;
    esac
done

if [ "$SHOW_SECTIONS" = "true" ]; then
    echo "Available configuration sections:"
    echo "  config-server     - Config Server settings"
    echo "  service-discovery - Service Discovery (Eureka) settings"
    echo "  client           - ONE Record Client settings"
    echo "  processor        - ONE Record Processor settings"
    echo "  server           - ONE Record Server settings"
    echo "  graphdb          - GraphDB settings"
    echo "  kafka            - Kafka settings"
    echo "  keycloak         - Keycloak settings"
    echo "  all              - All sections"
    exit 0
fi

echo "========================================"
echo "OntoMesh Environment Setup"
echo "========================================"

# Check if .env already exists
if [ -f ".env" ]; then
    if [ "$FORCE" = "true" ]; then
        print_warning "Overwriting existing .env file (--force specified)"
        rm .env
    else
        print_warning ".env file already exists!"
        echo ""
        read -p "Do you want to update the environment variables? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Skipping .env update"
            exit 0
        fi
    fi
    ENV_FILE=".env"
else
    print_info "Creating .env file from env.example..."
    cp env.example .env
    print_status ".env file created"
    ENV_FILE=".env"
fi

echo ""
echo "========================================"
echo "Configuring Environment Variables"
echo "========================================"

# Determine which sections to process
if [ -n "$SELECTED_SECTION" ]; then
    if [ "$SELECTED_SECTION" = "all" ]; then
        SECTIONS="config-server service-discovery client processor server graphdb kafka keycloak"
    elif section_exists "$SELECTED_SECTION"; then
        SECTIONS="$SELECTED_SECTION"
    else
        print_error "Unknown section: $SELECTED_SECTION"
        echo "Use --show-sections to see available sections"
        exit 1
    fi
else
    SECTIONS="config-server service-discovery client processor server graphdb kafka keycloak"
fi

# Process each configuration section
for section in $SECTIONS; do
    echo ""
    echo "🔧 $(get_section_name $section) Configuration"
    echo "----------------------------------------"
    
    # Get variables for this section
    vars=$(get_section_vars "$section")
    
    for var in $vars; do
        # Get current value from .env file
        current_value=$(grep "^${var}=" "$ENV_FILE" | cut -d'=' -f2- 2>/dev/null || echo "")
        
        # Get default value
        default_value=$(get_default_value "$var")
        
        # Get user input
        new_value=$(get_input "Enter $var" "$default_value" "$current_value" "$NON_INTERACTIVE")
        
        # Update the .env file
        update_env_var "$var" "$new_value" "$ENV_FILE"
        print_status "Updated $var"
    done
done

echo ""
echo "========================================"
echo "Environment Setup Complete!"
echo "========================================"
echo ""
print_info "📋 Key Service Credentials:"
echo "   Config Server: $(grep '^CONFIG_USERNAME=' .env | cut -d'=' -f2) / $(grep '^CONFIG_PASSWORD=' .env | cut -d'=' -f2)"
echo "   Eureka Service Discovery: $(grep '^EUREKA_USERNAME=' .env | cut -d'=' -f2) / $(grep '^EUREKA_PASSWORD=' .env | cut -d'=' -f2)"
echo "   GraphDB: $(grep '^REPOSITORY_USERNAME=' .env | cut -d'=' -f2) / $(grep '^REPOSITORY_PASSWORD=' .env | cut -d'=' -f2)"
echo "   PostgreSQL: $(grep '^POSTGRES_USER=' .env | cut -d'=' -f2) / $(grep '^POSTGRES_PASSWORD=' .env | cut -d'=' -f2)"
echo ""
print_info "🌐 Service URLs:"
echo "   Config Server: http://localhost:8888"
echo "   Service Discovery: http://localhost:8761/eurekawebui"
echo "   ONE Record Client: http://localhost:8081"
echo "   ONE Record Processor: http://localhost:8083"
echo "   ONE Record Server: http://localhost:8085"
echo "   GraphDB Workbench: http://localhost:7300"
echo "   Keycloak Admin: https://localhost:8443"
echo ""
print_info "🔧 To modify configuration later:"
echo "   1. Edit the .env file directly"
echo "   2. Run this script again: ./setup-env.sh"
echo "   3. Update config-repo files if needed"
echo ""
print_status "✅ You can now run: docker-compose up -d" 